<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="AppTitle">Image &amp; PDF Toolkit</sys:String>
    <sys:String x:Key="PreviewTitle">Preview</sys:String>
    <sys:String x:Key="DropSourcePrompt">Drop an image or PDF here, or click to browse</sys:String>
    <sys:String x:Key="WatermarksTitle">PNG Watermarks</sys:String>
    <sys:String x:Key="ChooseButton">Choose</sys:String>
    <sys:String x:Key="SizeLabel">Size</sys:String>
    <sys:String x:Key="IntensityLabel">Intensity</sys:String>
    <sys:String x:Key="IntensityHint">Light 10% / Dark 100%</sys:String>
    <sys:String x:Key="PositionLabel">Position</sys:String>
    <sys:String x:Key="MoveUpToolTip">Move up 5%</sys:String>
    <sys:String x:Key="MoveLeftToolTip">Move left 5%</sys:String>
    <sys:String x:Key="ResetPositionToolTip">Reset position</sys:String>
    <sys:String x:Key="MoveRightToolTip">Move right 5%</sys:String>
    <sys:String x:Key="MoveDownToolTip">Move down 5%</sys:String>
    <sys:String x:Key="StepHint">5% per step</sys:String>
    <sys:String x:Key="ApplyWatermarkButton">Apply Random Watermark</sys:String>
    <sys:String x:Key="SaveResultButton">Save to Output Folder</sys:String>
    <sys:String x:Key="ChooseOutputButton">Choose Output Folder</sys:String>
    <sys:String x:Key="CreatePdfButton">Create PDF from Folder Images</sys:String>
    <sys:String x:Key="RestoreSourceButton">Restore Source</sys:String>
    <sys:String x:Key="ClearWatermarksButton">Clear Watermarks</sys:String>
    <sys:String x:Key="LanguageLabel">Language</sys:String>

    <sys:String x:Key="WatermarkGroupTitleFormat">Watermark {0} Images (up to 3)</sys:String>
    <sys:String x:Key="WatermarkLayerTitleFormat">Watermark {0}</sys:String>
    <sys:String x:Key="WatermarkImagesTitle">PNG Images (up to 3)</sys:String>
    <sys:String x:Key="WatermarkCandidateTitleFormat">Image {0}</sys:String>
    <sys:String x:Key="WatermarkSettingsTitleFormat">Watermark {0} Settings</sys:String>
    <sys:String x:Key="WatermarkDropHint">Drop PNG or click to choose</sys:String>
    <sys:String x:Key="OffsetHorizontalFormat">Horizontal {0}</sys:String>
    <sys:String x:Key="OffsetVerticalFormat">Vertical {0}</sys:String>
    <sys:String x:Key="OutputDirectoryNotSelected">Output folder: Not selected</sys:String>
    <sys:String x:Key="OutputDirectoryMissingFormat">Output folder does not exist: {0}</sys:String>
    <sys:String x:Key="OutputDirectoryUnsafe">The output folder cannot be the source image folder</sys:String>
    <sys:String x:Key="OutputDirectoryFormat">Output folder: {0}</sys:String>

    <sys:String x:Key="DialogSelectSourceTitle">Select an Image or PDF</sys:String>
    <sys:String x:Key="DialogSupportedInputFiles">Supported files</sys:String>
    <sys:String x:Key="DialogImageFiles">Image files</sys:String>
    <sys:String x:Key="DialogPdfFiles">PDF files</sys:String>
    <sys:String x:Key="DialogAllFiles">All files</sys:String>
    <sys:String x:Key="DialogSelectWatermarkTitleFormat">Select Image {1} for Watermark {0}</sys:String>
    <sys:String x:Key="DialogPngImages">PNG images</sys:String>
    <sys:String x:Key="DialogSelectOutputTitle">Select Watermark Output Folder</sys:String>
    <sys:String x:Key="DialogSelectPdfOutputTitle">Select a Folder for Extracted PDF Pages</sys:String>

    <sys:String x:Key="TitleUnsupportedFormat">Unsupported Format</sys:String>
    <sys:String x:Key="MessageUnsupportedSource">Select a PNG, JPG, BMP, GIF, or TIFF image.</sys:String>
    <sys:String x:Key="TitleLoadFailed">Load Failed</sys:String>
    <sys:String x:Key="MessageLoadSourceFailedFormat">Failed to load the source image:{0}{1}</sys:String>
    <sys:String x:Key="MessageWatermarkPngOnly">Watermark slots accept PNG images only.</sys:String>
    <sys:String x:Key="MessageLoadWatermarkFailedFormat">Failed to load the watermark:{0}{1}</sys:String>
    <sys:String x:Key="TitleMissingSource">Source Image Required</sys:String>
    <sys:String x:Key="MessageMissingSource">Drop or select a source image first.</sys:String>
    <sys:String x:Key="TitleMissingWatermark">Watermark Required</sys:String>
    <sys:String x:Key="MessageMissingWatermark">Add at least one PNG image to this watermark group.</sys:String>
    <sys:String x:Key="MessageSelectedWatermarkMissing">The watermark used for this result is no longer available. Generate a new result.</sys:String>
    <sys:String x:Key="TitleNoResult">No Result</sys:String>
    <sys:String x:Key="MessageNoResult">Generate a watermarked result first.</sys:String>
    <sys:String x:Key="TitleSaveFailed">Save Failed</sys:String>
    <sys:String x:Key="MessageSaveFailedFormat">Failed to save the image:{0}{1}</sys:String>
    <sys:String x:Key="TitleUnsafeDirectory">Unsafe Folder</sys:String>
    <sys:String x:Key="MessageUnsafeDirectoryChooseAnother">The output folder cannot be the source image folder because a file with the same name could overwrite the original. Create or select another folder.</sys:String>
    <sys:String x:Key="MessageUnsafeDirectoryReselect">The output folder cannot be the source image folder because a file with the same name could overwrite the original. Select another output folder.</sys:String>
    <sys:String x:Key="TitleNoImages">No Images</sys:String>
    <sys:String x:Key="MessageNoImages">The output folder does not contain any images that can be added to a PDF.</sys:String>
    <sys:String x:Key="TitleGenerationFailed">Generation Failed</sys:String>
    <sys:String x:Key="MessagePdfFailedFormat">Failed to create the PDF:{0}{1}</sys:String>
    <sys:String x:Key="TitleMissingOutputDirectory">Output Folder Required</sys:String>
    <sys:String x:Key="MessageMissingOutputDirectory">Select an output folder first.</sys:String>
    <sys:String x:Key="TitleInvalidOutputDirectory">Invalid Output Folder</sys:String>
    <sys:String x:Key="MessageOutputDirectoryMissing">The output folder does not exist. Select it again.</sys:String>
    <sys:String x:Key="TitlePdfExtractionBusy">PDF Extraction in Progress</sys:String>
    <sys:String x:Key="MessagePdfExtractionBusy">Wait for the current PDF extraction to finish.</sys:String>
    <sys:String x:Key="TitlePdfExtractionFailed">PDF Extraction Failed</sys:String>
    <sys:String x:Key="MessagePdfExtractionFailedFormat">Failed to extract PDF pages:{0}{1}</sys:String>

    <sys:String x:Key="StatusReady">Ready</sys:String>
    <sys:String x:Key="StatusSourceLoadedFormat">Loaded source image: {0}</sys:String>
    <sys:String x:Key="StatusWatermarkLoadedFormat">Loaded image {1} for watermark {0}: {2}</sys:String>
    <sys:String x:Key="StatusWatermarkAppliedFormat">Applied watermark {0} · Size {1}% · Intensity {2}% · Horizontal {3} · Vertical {4} · Effective opacity {5:P0} · {6} {7:0.#}°</sys:String>
    <sys:String x:Key="StatusSingleWatermarkAppliedFormat">Applied watermark {0} using image {1}</sys:String>
    <sys:String x:Key="StatusDualWatermarksAppliedFormat">Applied both watermarks: watermark 1 uses image {0}, watermark 2 uses image {1}</sys:String>
    <sys:String x:Key="DirectionClockwise">Clockwise</sys:String>
    <sys:String x:Key="DirectionCounterclockwise">Counterclockwise</sys:String>
    <sys:String x:Key="StatusSettingsRemembered">Size, intensity, and position saved; they will apply to the next result</sys:String>
    <sys:String x:Key="StatusSavedFormat">Saved to the output folder: {0}; both position offsets reset to 0</sys:String>
    <sys:String x:Key="StatusOutputSelectedFormat">Selected output folder: {0}</sys:String>
    <sys:String x:Key="StatusPdfCreatedFormat">Created PDF: {0} ({1} image(s))</sys:String>
    <sys:String x:Key="StatusSourceRestored">Restored the source image</sys:String>
    <sys:String x:Key="StatusWatermarksCleared">Cleared all watermarks</sys:String>
    <sys:String x:Key="StatusAssetsRestoredFormat">Restored previous assets: {0}, {1} watermark(s)</sys:String>
    <sys:String x:Key="RestoredSourceImage">source image</sys:String>
    <sys:String x:Key="RestoredNoSourceImage">no source image</sys:String>
    <sys:String x:Key="StatusLanguageChangedFormat">Language changed to {0}</sys:String>
    <sys:String x:Key="StatusPdfExtractionStartingFormat">Opening PDF: {0}</sys:String>
    <sys:String x:Key="StatusPdfExtractionPreparingFormat">Preparing to extract {0} PDF page(s)</sys:String>
    <sys:String x:Key="StatusPdfExtractionProgressFormat">Extracting PDF page {0} of {1}</sys:String>
    <sys:String x:Key="StatusPdfExtractionCompletedFormat">Extracted {0} PDF page(s) to: {1}</sys:String>
    <sys:String x:Key="StatusPdfExtractionFailed">PDF extraction failed</sys:String>
    <sys:String x:Key="MergedPdfFileName">MergedResult.pdf</sys:String>
</ResourceDictionary>
