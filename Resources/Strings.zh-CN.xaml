<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:String x:Key="AppTitle">图片与 PDF 工具箱</sys:String>
    <sys:String x:Key="PreviewTitle">预览</sys:String>
    <sys:String x:Key="DropSourcePrompt">拖入图片或 PDF，或点击选择文件</sys:String>
    <sys:String x:Key="WatermarksTitle">PNG 水印</sys:String>
    <sys:String x:Key="ChooseButton">选择</sys:String>
    <sys:String x:Key="SizeLabel">大小</sys:String>
    <sys:String x:Key="IntensityLabel">深浅</sys:String>
    <sys:String x:Key="IntensityHint">浅 10% / 深 100%</sys:String>
    <sys:String x:Key="PositionLabel">位置</sys:String>
    <sys:String x:Key="MoveUpToolTip">向上移动 5%</sys:String>
    <sys:String x:Key="MoveLeftToolTip">向左移动 5%</sys:String>
    <sys:String x:Key="ResetPositionToolTip">位置归零</sys:String>
    <sys:String x:Key="MoveRightToolTip">向右移动 5%</sys:String>
    <sys:String x:Key="MoveDownToolTip">向下移动 5%</sys:String>
    <sys:String x:Key="StepHint">每次 5%</sys:String>
    <sys:String x:Key="ApplyWatermarkButton">随机盖水印</sys:String>
    <sys:String x:Key="SaveResultButton">保存到输出目录</sys:String>
    <sys:String x:Key="ChooseOutputButton">选择输出目录</sys:String>
    <sys:String x:Key="CreatePdfButton">目录图片生成 PDF</sys:String>
    <sys:String x:Key="RestoreSourceButton">恢复原图</sys:String>
    <sys:String x:Key="ClearWatermarksButton">清空水印</sys:String>
    <sys:String x:Key="LanguageLabel">语言</sys:String>

    <sys:String x:Key="WatermarkGroupTitleFormat">水印 {0} 图片（最多 3 张）</sys:String>
    <sys:String x:Key="WatermarkLayerTitleFormat">水印 {0}</sys:String>
    <sys:String x:Key="WatermarkImagesTitle">PNG 图片（最多 3 张）</sys:String>
    <sys:String x:Key="WatermarkCandidateTitleFormat">图片 {0}</sys:String>
    <sys:String x:Key="WatermarkSettingsTitleFormat">水印 {0} 参数</sys:String>
    <sys:String x:Key="WatermarkDropHint">拖入 PNG 或点击选择</sys:String>
    <sys:String x:Key="OffsetHorizontalFormat">左右 {0}</sys:String>
    <sys:String x:Key="OffsetVerticalFormat">上下 {0}</sys:String>
    <sys:String x:Key="OutputDirectoryNotSelected">输出目录：未选择</sys:String>
    <sys:String x:Key="OutputDirectoryMissingFormat">输出目录不存在：{0}</sys:String>
    <sys:String x:Key="OutputDirectoryUnsafe">输出目录不能是原图所在文件夹</sys:String>
    <sys:String x:Key="OutputDirectoryFormat">输出目录：{0}</sys:String>

    <sys:String x:Key="DialogSelectSourceTitle">选择图片或 PDF</sys:String>
    <sys:String x:Key="DialogSupportedInputFiles">支持的文件</sys:String>
    <sys:String x:Key="DialogImageFiles">图片文件</sys:String>
    <sys:String x:Key="DialogPdfFiles">PDF 文件</sys:String>
    <sys:String x:Key="DialogAllFiles">所有文件</sys:String>
    <sys:String x:Key="DialogSelectWatermarkTitleFormat">选择水印 {0} 的图片 {1}</sys:String>
    <sys:String x:Key="DialogPngImages">PNG 图片</sys:String>
    <sys:String x:Key="DialogSelectOutputTitle">选择水印结果输出目录</sys:String>
    <sys:String x:Key="DialogSelectPdfOutputTitle">选择 PDF 分页图片保存目录</sys:String>

    <sys:String x:Key="TitleUnsupportedFormat">格式不支持</sys:String>
    <sys:String x:Key="MessageUnsupportedSource">请选择 PNG、JPG、BMP、GIF 或 TIFF 图片。</sys:String>
    <sys:String x:Key="TitleLoadFailed">载入失败</sys:String>
    <sys:String x:Key="MessageLoadSourceFailedFormat">底图载入失败：{0}{1}</sys:String>
    <sys:String x:Key="MessageWatermarkPngOnly">水印槽只接受 PNG 图片。</sys:String>
    <sys:String x:Key="MessageLoadWatermarkFailedFormat">水印载入失败：{0}{1}</sys:String>
    <sys:String x:Key="TitleMissingSource">缺少底图</sys:String>
    <sys:String x:Key="MessageMissingSource">请先拖入底图。</sys:String>
    <sys:String x:Key="TitleMissingWatermark">缺少水印</sys:String>
    <sys:String x:Key="MessageMissingWatermark">请在当前水印组中至少放入 1 张 PNG 图片。</sys:String>
    <sys:String x:Key="MessageSelectedWatermarkMissing">这次生成使用的水印已经不存在，请重新生成。</sys:String>
    <sys:String x:Key="TitleNoResult">没有结果</sys:String>
    <sys:String x:Key="MessageNoResult">请先生成水印结果。</sys:String>
    <sys:String x:Key="TitleSaveFailed">保存失败</sys:String>
    <sys:String x:Key="MessageSaveFailedFormat">保存失败：{0}{1}</sys:String>
    <sys:String x:Key="TitleUnsafeDirectory">目录不安全</sys:String>
    <sys:String x:Key="MessageUnsafeDirectoryChooseAnother">输出目录不能选择原图所在文件夹，否则同名保存会覆盖原图。请新建或选择另一个目录。</sys:String>
    <sys:String x:Key="MessageUnsafeDirectoryReselect">输出目录不能是原图所在文件夹，否则同名保存会覆盖原图。请重新选择输出目录。</sys:String>
    <sys:String x:Key="TitleNoImages">没有图片</sys:String>
    <sys:String x:Key="MessageNoImages">输出目录里没有可生成 PDF 的图片。</sys:String>
    <sys:String x:Key="TitleGenerationFailed">生成失败</sys:String>
    <sys:String x:Key="MessagePdfFailedFormat">生成 PDF 失败：{0}{1}</sys:String>
    <sys:String x:Key="TitleMissingOutputDirectory">缺少输出目录</sys:String>
    <sys:String x:Key="MessageMissingOutputDirectory">请先点击“选择输出目录”。</sys:String>
    <sys:String x:Key="TitleInvalidOutputDirectory">输出目录无效</sys:String>
    <sys:String x:Key="MessageOutputDirectoryMissing">输出目录不存在，请重新选择。</sys:String>
    <sys:String x:Key="TitlePdfExtractionBusy">正在拆分 PDF</sys:String>
    <sys:String x:Key="MessagePdfExtractionBusy">请等待当前 PDF 拆分完成。</sys:String>
    <sys:String x:Key="TitlePdfExtractionFailed">PDF 拆分失败</sys:String>
    <sys:String x:Key="MessagePdfExtractionFailedFormat">PDF 分页转图片失败：{0}{1}</sys:String>

    <sys:String x:Key="StatusReady">准备就绪</sys:String>
    <sys:String x:Key="StatusSourceLoadedFormat">已载入底图：{0}</sys:String>
    <sys:String x:Key="StatusWatermarkLoadedFormat">已载入水印 {0} 的图片 {1}：{2}</sys:String>
    <sys:String x:Key="StatusWatermarkAppliedFormat">已使用水印 {0} · 大小 {1}% · 深浅 {2}% · 左右 {3} · 上下 {4} · 实际强度 {5:P0} · {6} {7:0.#}°</sys:String>
    <sys:String x:Key="StatusSingleWatermarkAppliedFormat">已随机叠加水印 {0}（图片 {1}）</sys:String>
    <sys:String x:Key="StatusDualWatermarksAppliedFormat">已叠加双水印：水印 1 使用图片 {0}，水印 2 使用图片 {1}</sys:String>
    <sys:String x:Key="DirectionClockwise">顺时针</sys:String>
    <sys:String x:Key="DirectionCounterclockwise">逆时针</sys:String>
    <sys:String x:Key="StatusSettingsRemembered">已记住水印大小、深浅和位置，下一次生成生效</sys:String>
    <sys:String x:Key="StatusSavedFormat">已保存到输出目录：{0}，两组左右/上下均已重置为 0</sys:String>
    <sys:String x:Key="StatusOutputSelectedFormat">已选择输出目录：{0}</sys:String>
    <sys:String x:Key="StatusPdfCreatedFormat">已生成 PDF：{0}，共 {1} 张图片</sys:String>
    <sys:String x:Key="StatusSourceRestored">已恢复原图</sys:String>
    <sys:String x:Key="StatusWatermarksCleared">已清空水印</sys:String>
    <sys:String x:Key="StatusAssetsRestoredFormat">已恢复上次素材：{0}，{1} 个水印</sys:String>
    <sys:String x:Key="RestoredSourceImage">底图</sys:String>
    <sys:String x:Key="RestoredNoSourceImage">无底图</sys:String>
    <sys:String x:Key="StatusLanguageChangedFormat">语言已切换为 {0}</sys:String>
    <sys:String x:Key="StatusPdfExtractionStartingFormat">正在打开 PDF：{0}</sys:String>
    <sys:String x:Key="StatusPdfExtractionPreparingFormat">准备导出 {0} 页 PDF</sys:String>
    <sys:String x:Key="StatusPdfExtractionProgressFormat">正在导出 PDF 第 {0}/{1} 页</sys:String>
    <sys:String x:Key="StatusPdfExtractionCompletedFormat">已将 PDF 的 {0} 页图片保存到：{1}</sys:String>
    <sys:String x:Key="StatusPdfExtractionFailed">PDF 拆分失败</sys:String>
    <sys:String x:Key="MergedPdfFileName">合并结果.pdf</sys:String>
</ResourceDictionary>
