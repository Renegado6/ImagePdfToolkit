<UserControl x:Class="ImagePdfToolkit.Controls.NumericStepper"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="108"
             Height="36">
    <Border Background="White"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="ValueTextBox"
                     Grid.Column="0"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     FontSize="13"
                     Foreground="{StaticResource TextBrush}"
                     Text="{Binding Value, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                     PreviewKeyDown="ValueTextBox_OnPreviewKeyDown"
                     LostKeyboardFocus="ValueTextBox_OnLostKeyboardFocus" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <RepeatButton Grid.Row="0"
                              Click="IncreaseButton_OnClick"
                              Delay="350"
                              Interval="70"
                              Background="Transparent"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1,0,0,0"
                              Focusable="False">
                    <Path Data="M 2 6 L 6 2 L 10 6"
                          Stroke="{StaticResource MutedTextBrush}"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </RepeatButton>
                <RepeatButton Grid.Row="1"
                              Click="DecreaseButton_OnClick"
                              Delay="350"
                              Interval="70"
                              Background="Transparent"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1,1,0,0"
                              Focusable="False">
                    <Path Data="M 2 2 L 6 6 L 10 2"
                          Stroke="{StaticResource MutedTextBrush}"
                          StrokeThickness="1.3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
