<UserControl x:Class="ImagePdfToolkit.Controls.WatermarkAdjustmentEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ImagePdfToolkit.Controls"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="42" />
            <RowDefinition Height="42" />
            <RowDefinition Height="104" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="116" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                   Text="{Binding Title}"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource AccentBrush}" />

        <TextBlock Grid.Row="1" Grid.Column="0"
                   Text="{DynamicResource SizeLabel}"
                   Style="{StaticResource FieldLabelStyle}" />
        <controls:NumericStepper Grid.Row="1" Grid.Column="1"
                                 Value="{Binding SizePercent, Mode=TwoWay}"
                                 Minimum="10"
                                 Maximum="300"
                                 Step="5" />
        <TextBlock Grid.Row="1" Grid.Column="2"
                   Text="%"
                   Margin="10,0,0,0"
                   Style="{StaticResource FieldLabelStyle}" />

        <TextBlock Grid.Row="2" Grid.Column="0"
                   Text="{DynamicResource IntensityLabel}"
                   Style="{StaticResource FieldLabelStyle}" />
        <controls:NumericStepper Grid.Row="2" Grid.Column="1"
                                 Value="{Binding ColorDepthPercent, Mode=TwoWay}"
                                 Minimum="10"
                                 Maximum="100"
                                 Step="5" />
        <TextBlock Grid.Row="2" Grid.Column="2"
                   Text="{DynamicResource IntensityHint}"
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource MutedTextStyle}" />

        <TextBlock Grid.Row="3" Grid.Column="0"
                   Text="{DynamicResource PositionLabel}"
                   Style="{StaticResource FieldLabelStyle}" />

        <Grid Grid.Row="3" Grid.Column="1" Width="116" Height="104">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Width="36" Height="32"
                    ToolTip="{DynamicResource MoveUpToolTip}"
                    Command="{Binding MoveOffsetCommand}"
                    CommandParameter="Up">
                <Path Data="M 5 12 L 12 5 L 19 12 M 12 5 L 12 20"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Button>
            <Button Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource IconButtonStyle}"
                    Width="36" Height="32"
                    ToolTip="{DynamicResource MoveLeftToolTip}"
                    Command="{Binding MoveOffsetCommand}"
                    CommandParameter="Left">
                <Path Data="M 12 5 L 5 12 L 12 19 M 5 12 L 20 12"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Button>
            <Button Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Width="40" Height="36"
                    ToolTip="{DynamicResource ResetPositionToolTip}"
                    Command="{Binding MoveOffsetCommand}"
                    CommandParameter="Reset">
                <Grid Width="22" Height="22">
                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             StrokeThickness="1.7"
                             Margin="4" />
                    <Path Data="M 11 1 L 11 7 M 11 15 L 11 21 M 1 11 L 7 11 M 15 11 L 21 11"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round" />
                </Grid>
            </Button>
            <Button Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource IconButtonStyle}"
                    Width="36" Height="32"
                    ToolTip="{DynamicResource MoveRightToolTip}"
                    Command="{Binding MoveOffsetCommand}"
                    CommandParameter="Right">
                <Path Data="M 12 5 L 19 12 L 12 19 M 4 12 L 19 12"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Button>
            <Button Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource IconButtonStyle}"
                    Width="36" Height="32"
                    ToolTip="{DynamicResource MoveDownToolTip}"
                    Command="{Binding MoveOffsetCommand}"
                    CommandParameter="Down">
                <Path Data="M 5 9 L 12 16 L 19 9 M 12 2 L 12 16"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="3" Grid.Column="2"
                    Margin="14,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock Text="{Binding OffsetXDisplay}" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding OffsetYDisplay}" Style="{StaticResource FieldLabelStyle}" Margin="0,7,0,0" />
            <TextBlock Text="{DynamicResource StepHint}" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0" />
        </StackPanel>

        <Button Grid.Row="4" Grid.ColumnSpan="3"
                Content="{DynamicResource ApplyWatermarkButton}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding DataContext.ApplyWatermarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding Index}"
                Margin="0,8,0,0" />
    </Grid>
</UserControl>
