<Window x:Class="ImagePdfToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImagePdfToolkit.Controls"
        Title="{DynamicResource AppTitle}"
        Width="1440"
        Height="900"
        MinWidth="1320"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Closing="Window_OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="42" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="500" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1.45*" MinWidth="760" MaxWidth="920" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="18,14,18,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{DynamicResource PreviewTitle}"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Grid x:Name="PreviewDropZone"
                          Grid.Row="1"
                          Margin="0,4,0,0"
                          Background="#FBFCFE"
                          Cursor="Hand"
                          AllowDrop="True"
                          MouseLeftButtonUp="PreviewDropZone_OnMouseLeftButtonUp"
                          DragEnter="PreviewDropZone_OnDragEnter"
                          DragOver="PreviewDropZone_OnDragEnter"
                          Drop="PreviewDropZone_OnDrop">
                        <Rectangle Stroke="#B9C4D3"
                                   StrokeThickness="1.2"
                                   StrokeDashArray="5 4"
                                   RadiusX="9"
                                   RadiusY="9" />

                        <Border Margin="12" ClipToBounds="True" CornerRadius="7">
                            <Image Source="{Binding PreviewImage}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Grid Width="76" Height="66" Margin="0,0,0,18">
                                <Rectangle Stroke="#A8B2C1"
                                           StrokeThickness="3"
                                           RadiusX="7"
                                           RadiusY="7"
                                           Margin="6,8,6,4" />
                                <Ellipse Width="13" Height="13" Fill="#A8B2C1" Margin="0,0,22,22" />
                                <Path Data="M 13 52 L 29 35 L 39 45 L 50 31 L 65 52 Z"
                                      Fill="#A8B2C1" />
                            </Grid>
                            <TextBlock Text="{DynamicResource DropSourcePrompt}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="#7A8697"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
                <StackPanel>
                    <Border Background="Transparent" Padding="0" Margin="0,0,0,2">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WatermarksTitle}"
                                       Style="{StaticResource SectionTitleStyle}"
                                       Margin="0,0,0,10" />

                            <ItemsControl ItemsSource="{Binding WatermarkGroups}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,12,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="{Binding ImagesTitle}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       Margin="0,0,0,3" />
                                            <ItemsControl ItemsSource="{Binding Slots}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <Border Grid.Column="1"
                                                    Width="38"
                                                    Height="36"
                                                    Margin="0,0,7,0"
                                                    Background="#F7F9FC"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    AllowDrop="True"
                                                    Cursor="Hand"
                                                    MouseLeftButtonUp="WatermarkSlot_OnMouseLeftButtonUp"
                                                    DragEnter="WatermarkSlot_OnDragEnter"
                                                    DragOver="WatermarkSlot_OnDragEnter"
                                                    Drop="WatermarkSlot_OnDrop">
                                                <Grid>
                                                    <Image Source="{Binding PreviewImage}"
                                                           Stretch="Uniform"
                                                           Margin="3"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <Path Data="M 8 10 L 18 10 L 21 14 L 29 14 L 29 26 L 8 26 Z"
                                                          Stroke="#A5AFBD"
                                                          StrokeThickness="1.3"
                                                          Fill="Transparent"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasImage}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Grid>
                                            </Border>

                                            <Border Grid.Column="2"
                                                    Height="36"
                                                    Margin="0,0,8,0"
                                                    Padding="10,0"
                                                    Background="#FBFCFE"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Cursor="Hand"
                                                    AllowDrop="True"
                                                    MouseLeftButtonUp="WatermarkSlot_OnMouseLeftButtonUp"
                                                    DragEnter="WatermarkSlot_OnDragEnter"
                                                    DragOver="WatermarkSlot_OnDragEnter"
                                                    Drop="WatermarkSlot_OnDrop">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource MutedTextStyle}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding FilePath}" />
                                            </Border>

                                            <Button Grid.Column="3"
                                                    Height="36"
                                                    Padding="8,0"
                                                    Content="{DynamicResource ChooseButton}"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Command="{Binding DataContext.PickWatermarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Height="1"
                                                    Background="{StaticResource BorderBrush}"
                                                    Margin="0,10,0,12" />
                                            <controls:WatermarkAdjustmentEditor DataContext="{Binding Adjustment}" />
                                        </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- The adjustment editor is rendered inside each WatermarkGroup card above. -->
                    <ItemsControl ItemsSource="{Binding WatermarkAdjustments}" Visibility="Collapsed" Height="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="30" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="42" />
                                            <RowDefinition Height="104" />
                                            <RowDefinition Height="50" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="116" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                                   Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SizeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                        <controls:NumericStepper Grid.Row="1"
                                                                 Grid.Column="1"
                                                                 Value="{Binding SizePercent, Mode=TwoWay}"
                                                                 Minimum="10"
                                                                 Maximum="300"
                                                                 Step="5" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="%" Margin="10,0,0,0" Style="{StaticResource FieldLabelStyle}" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource IntensityLabel}" Style="{StaticResource FieldLabelStyle}" />
                                        <controls:NumericStepper Grid.Row="2"
                                                                 Grid.Column="1"
                                                                 Value="{Binding ColorDepthPercent, Mode=TwoWay}"
                                                                 Minimum="10"
                                                                 Maximum="100"
                                                                 Step="5" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Text="{DynamicResource IntensityHint}"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource MutedTextStyle}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource PositionLabel}" Style="{StaticResource FieldLabelStyle}" />

                                        <Grid Grid.Row="3" Grid.Column="1" Width="116" Height="104">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Row="0" Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Width="36" Height="32"
                                                    ToolTip="{DynamicResource MoveUpToolTip}"
                                                    Command="{Binding MoveOffsetCommand}"
                                                    CommandParameter="Up">
                                                <Path Data="M 5 12 L 12 5 L 19 12 M 12 5 L 12 20"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="0"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Width="36" Height="32"
                                                    ToolTip="{DynamicResource MoveLeftToolTip}"
                                                    Command="{Binding MoveOffsetCommand}"
                                                    CommandParameter="Left">
                                                <Path Data="M 12 5 L 5 12 L 12 19 M 5 12 L 20 12"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Width="40" Height="36"
                                                    ToolTip="{DynamicResource ResetPositionToolTip}"
                                                    Command="{Binding MoveOffsetCommand}"
                                                    CommandParameter="Reset">
                                                <Grid Width="22" Height="22">
                                                    <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                             StrokeThickness="1.7"
                                                             Margin="4" />
                                                    <Path Data="M 11 1 L 11 7 M 11 15 L 11 21 M 1 11 L 7 11 M 15 11 L 21 11"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.7"
                                                          StrokeStartLineCap="Round" />
                                                </Grid>
                                            </Button>
                                            <Button Grid.Row="1" Grid.Column="2"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Width="36" Height="32"
                                                    ToolTip="{DynamicResource MoveRightToolTip}"
                                                    Command="{Binding MoveOffsetCommand}"
                                                    CommandParameter="Right">
                                                <Path Data="M 12 5 L 19 12 L 12 19 M 4 12 L 19 12"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Button>
                                            <Button Grid.Row="2" Grid.Column="1"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Width="36" Height="32"
                                                    ToolTip="{DynamicResource MoveDownToolTip}"
                                                    Command="{Binding MoveOffsetCommand}"
                                                    CommandParameter="Down">
                                                <Path Data="M 5 9 L 12 16 L 19 9 M 12 2 L 12 16"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" />
                                            </Button>
                                        </Grid>

                                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding OffsetXDisplay}" Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding OffsetYDisplay}" Style="{StaticResource FieldLabelStyle}" Margin="0,7,0,0" />
                                            <TextBlock Text="{DynamicResource StepHint}" Style="{StaticResource MutedTextStyle}" Margin="0,7,0,0" />
                                        </StackPanel>

                                        <Button Grid.Row="4" Grid.ColumnSpan="3"
                                                Content="{DynamicResource ApplyWatermarkButton}"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.ApplyWatermarkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Index}"
                                                Margin="0,8,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="{DynamicResource SaveResultButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding SaveResultCommand}"
                            Margin="0,0,0,9" />
                    <Button Content="{DynamicResource ChooseOutputButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ChooseOutputDirectoryCommand}"
                            Margin="0,0,0,9" />

                    <TextBlock Text="{Binding OutputDirectoryDisplay}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding OutputDirectoryDisplay}"
                               Margin="3,0,3,9">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOutputDirectoryError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Content="{DynamicResource CreatePdfButton}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CreatePdfCommand}"
                            Margin="0,0,0,9" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="{DynamicResource RestoreSourceButton}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ResetPreviewCommand}" />
                        <Button Grid.Column="2"
                                Content="{DynamicResource ClearWatermarksButton}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearWatermarksCommand}" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0"
                         Width="18"
                         Height="18"
                         Stroke="#7B8797"
                         StrokeThickness="1.4" />
                <Path Grid.Column="0"
                      Data="M 7 12 L 10 15 L 15 8"
                      Stroke="#7B8797"
                      StrokeThickness="1.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           ToolTip="{Binding StatusText}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Text="{DynamicResource LanguageLabel}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="4"
                          Height="28"
                          Padding="8,1"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
